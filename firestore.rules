rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read the videos so the portfolio can show them.
    // Only your own admin account can add, edit, reorder or delete.
    match /videos/{id} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'YOUR_ADMIN_EMAIL_HERE';
    }
  }
}
