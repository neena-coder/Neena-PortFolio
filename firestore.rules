rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public portfolio visitors can read published videos.
    // Only the portfolio administrator can create, edit, reorder or delete videos.
    match /videos/{id} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'nynvisuals@gmail.com';
    }
  }
}
